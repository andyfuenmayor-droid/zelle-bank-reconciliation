# PostgreSQL Directo (Pool Nativo pg)
DATABASE_URL="postgresql://fintech_user:strong_password@localhost:5432/fintech_reconciliation?sslmode=prefer"
PG_POOL_MAX="20"
PG_SSL_ENABLED="false"

# Servidor IMAP de Alertas Bancarias Dedicado
IMAP_HOST="imap.tudominio-fintech.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="alerts-zelle@tudominio-fintech.com"
IMAP_PASS="app-specific-password-or-secret"
IMAP_MAILBOX="INBOX"

# Seguridad del Worker Cron
CRON_SECRET="super-secret-cron-token-min-32-chars"

# Motor AI Fallback (OpenAI o Anthropic)
AI_PROVIDER="openai" # "openai" | "anthropic"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Configuración de Comisión por Defecto (%)
DEFAULT_FEE_PERCENTAGE="4.00"

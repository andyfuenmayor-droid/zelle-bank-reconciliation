# PostgreSQL Directo (Pool Nativo pg)
DATABASE_URL="postgresql://fintech_user:strong_password@localhost:5432/fintech_reconciliation?sslmode=prefer"
PG_POOL_MAX="20"
PG_SSL_ENABLED="false"

# Servidor IMAP de Alertas Bancarias y Binance (@citibank.com, @tdbank.com, @binance.com)
IMAP_HOST="imap.tudominio-fintech.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="alerts-zelle@tudominio-fintech.com"
IMAP_PASS="app-specific-password-or-secret"
IMAP_MAILBOX="INBOX"
IMAP_SYNC_SINCE="2026-10-19T00:00:00.000Z"

# Binance API Oficial (Pay, P2P C2C y Depósitos On-Chain)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_API_BASE_URL="https://api.binance.com"

# Seguridad del Worker Cron (/api/cron/sync-payments)
CRON_SECRET="super-secret-cron-token-min-32-chars"

# Motor AI Fallback y Vision OCR (OpenAI o Anthropic)
AI_PROVIDER="openai" # "openai" | "anthropic"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Configuración de Comisiones por Defecto (%)
ZELLE_DEFAULT_FEE_PERCENT="4.00"
BINANCE_DEFAULT_FEE_PERCENT="1.50"
DEFAULT_FEE_PERCENTAGE="4.00"
